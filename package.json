{
  "name": "secureflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:auth:migrate": "npx auth@latest migrate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
    ,"test:e2e": "vitest run tests/e2e"
    ,"test:security": "vitest run tests/security"
    ,"typecheck": "tsc -p tsconfig.json --noEmit"
    ,"lint": "tsc -p tsconfig.json --noEmit"
    ,"db:seed": "tsx scripts/seed-demo.ts"
    ,"audit:verify": "tsx scripts/verify-audit-chain.ts"
    ,"defense:check": "tsx scripts/defense-check.ts"
    ,"backup:full": "tsx scripts/backup-full.ts"
    ,"backup:verify": "tsx scripts/verify-backup.ts"
    ,"restore:test": "tsx scripts/restore-test.ts"
  },
  "dependencies": {
    "better-auth": "latest",
    "bcryptjs": "latest",
    "@aws-sdk/client-s3": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "jose": "latest",
    "ioredis": "latest",
    "nodemailer": "latest",
    "otplib": "^12.0.1",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
