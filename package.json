{
  "name": "secureflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:auth:migrate": "npx auth@latest migrate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:security": "vitest run tests/security",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "db:promote-admin": "tsx scripts/promote-admin.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "defense:check": "tsx scripts/defense-check.ts",
    "backup:full": "tsx scripts/backup-full.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "restore:test": "tsx scripts/restore-test.ts",
    "restore:isolated": "tsx scripts/restore-isolated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "bcryptjs": "latest",
    "better-auth": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "ioredis": "latest",
    "jose": "latest",
    "jsonwebtoken": "latest",
    "nodemailer": "latest",
    "otplib": "^12.0.1",
    "pg": "latest",
    "qrcode": "^1.5.4",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "^1.5.6",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  }
}
